<table class="data-table">
    <thead>
        <tr>
            <th>Kundennummer</th>
            <th>Name</th>
            <th>E-Mail</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Customers.Count == 0)
        {
            <tr>
                <td colspan="5">Keine Kunden gefunden.</td>
            </tr>
        }
        else
        {
            @foreach (var customer in Customers)
            {
                <tr>
                    <td>@customer.CustomerNumber</td>
                    <td>@customer.FullName</td>
                    <td>@customer.Email</td>
                    <td><StatusBadge Status="@customer.Status.ToString()" /></td>
                    <td><a href="@($"/customers/{customer.Id}")">Details</a></td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CustomerSummary> Customers { get; set; } = [];
}
