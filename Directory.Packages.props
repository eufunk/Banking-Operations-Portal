<Project>

  <!--
    Central Package Management: Paketversionen werden ausschließlich hier gepflegt.
    Einzelne .csproj-Dateien referenzieren Pakete ohne Version-Attribut.
    Vorteil in einer Multi-Projekt-Solution: keine widersprüchlichen Versionen zwischen
    Projekten, ein Blick genügt für ein Dependency-/Security-Audit.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Banking.Api -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Explizit gepinnt: behebt GHSA-v5pm-xwqc-g5wc (High Severity) aus Microsoft.AspNetCore.OpenApi 10.0.7 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- EF-Core-Tooling (Migrations) - läuft über das Api-Projekt als Startup-Projekt -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- Azure-Konfiguration (Kapitel 9): nur aktiv, wenn AzureAppConfiguration:Endpoint bzw.
         KeyVault:Uri konfiguriert sind - lokal ohne Azure-Subscription bleibt der Codepfad
         ungenutzt, ist aber bereits korrekt vorbereitet (DefaultAzureCredential nutzt beim
         Deployment automatisch Managed Identity, lokal ggf. Azure-CLI-Login). -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.6.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <!-- Observability (Kapitel 10): OpenTelemetry-SDK + Instrumentierung, immer aktiv mit
         Konsolen-Export lokal; der Azure-Monitor-Exporter kommt nur hinzu, wenn
         ApplicationInsights:ConnectionString konfiguriert ist. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />

    <!-- Banking.Application -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!-- services.Configure&lt;T&gt;(IConfigurationSection) - bindet Options an appsettings/Env/User Secrets -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!-- Banking.Web -->
    <!-- Kostenlose, offizielle Microsoft-Komponente statt Telerik UI for Blazor: keine
         Lizenz/kein privater NuGet-Feed konfiguriert. Funktional (Sorting/Paging) identisch
         für unseren Bedarf, später 1:1 gegen TelerikGrid austauschbar. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.11" />
    <!-- Web mintet nach Cookie-Login ein kurzlebiges JWT für ausgehende Api-Aufrufe (BFF-Pattern) -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />

    <!-- Banking.Infrastructure -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <!-- Direkt gepinnt: EF Core 10.0.11 zieht transitiv Microsoft.Data.SqlClient 6.1.6 mit
         SNI.runtime 6.0.2 - dieser Versionsstand lädt die native SNI-DLL nicht zuverlässig
         gegen aktuelle LocalDB-Installationen (SQL Server 2025 LocalDB, Fehler beim Laden
         der SqlUserInstance-Ressourcen). Neueste stabile Version behebt das. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- SAP-Integration (Kapitel 11): Timeout/Retry/Circuit-Breaker für die HttpClient-basierte
         SAP-Anbindung als Cross-Cutting-Concern statt Handgeschriebenem - offizielles,
         Microsoft-gepflegtes Resilience-Paket (baut auf Polly v8 auf). -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />

    <!-- Testprojekte -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
